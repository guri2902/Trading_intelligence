/* Phase 13 — Settings additions.
   Append these rules to frontend/app/globals.css. */
.settings-page-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--surface-active);color:var(--accent);border:1px solid var(--border)}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.settings-card{padding:20px}
.settings-title{margin-top:5px;margin-bottom:18px}
.settings-toggle-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 0;border-bottom:1px solid var(--border)}
.settings-toggle-row:last-child{border-bottom:0}
.settings-toggle-row strong{display:block;color:var(--text-primary);font-size:13px}
.settings-toggle-row p{margin:4px 0 0;max-width:520px;color:var(--text-secondary);font-size:11px;line-height:1.45}
.settings-toggle{width:42px;height:24px;flex:0 0 auto;border:1px solid var(--border);border-radius:999px;background:var(--surface-active);padding:2px;cursor:pointer;transition:background .14s ease,border-color .14s ease}
.settings-toggle span{display:block;width:18px;height:18px;border-radius:50%;background:var(--text-tertiary);transition:transform .14s ease,background .14s ease}
.settings-toggle.on{background:var(--accent);border-color:var(--accent)}
.settings-toggle.on span{background:var(--accent-contrast);transform:translateX(17px)}
.settings-info{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.settings-info:last-child{border-bottom:0}
.settings-info strong{font-size:12px;color:var(--text-secondary)}
.settings-info>span:not(.pill){font-size:13px;font-variant-numeric:tabular-nums;color:var(--text-primary)}
.settings-safety{display:grid;grid-template-columns:auto 1fr;gap:10px;padding:13px;margin-top:14px;border:1px solid var(--border);border-radius:9px;background:var(--surface-hover)}
.settings-lock{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--border);border-radius:8px;background:var(--surface-active);color:var(--accent)}
.settings-safety strong{font-size:12px;color:var(--text-primary)}
.settings-safety p{margin:4px 0 0;font-size:11px;line-height:1.45;color:var(--text-secondary)}
.settings-copy{font-size:12px;line-height:1.55;color:var(--text-secondary);max-width:650px}
.settings-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.settings-saved{margin-top:13px}
.settings-integrity{margin-top:16px;padding:18px 20px}
@media(max-width:800px){.settings-grid{grid-template-columns:1fr}}
