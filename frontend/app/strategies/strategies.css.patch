/* Phase 9 — Strategies additions.
   Append these rules to frontend/app/globals.css. */
.strategies-page-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--surface-active);color:var(--accent);border:1px solid var(--border)}
.strat-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border);margin:16px 0 18px}
.strat-tab{border:0;background:transparent;color:var(--text-secondary);padding:10px 14px;font:inherit;font-size:12px;font-weight:700;border-bottom:2px solid transparent;cursor:pointer}
.strat-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.strat-builder-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}
.strat-builder-main,.strat-side{padding:20px}
.strat-builder-main label{margin-top:14px}
.strat-rule-box{margin-top:16px;padding:14px;border-radius:9px;border:1px solid var(--border);background:var(--surface-hover);display:grid;gap:6px}
.strat-rule-box strong{font-family:monospace;font-size:13px;color:var(--accent)}
.strat-rule-box span{font-size:12px;line-height:1.5;color:var(--text-secondary)}
.strat-actions{display:flex;gap:8px;margin-top:16px}
.strat-status{margin-top:14px}
.strat-side-title{font-family:Georgia,serif;font-size:22px;font-weight:500;color:var(--text-primary);margin:6px 0 9px}
.strat-detail{display:grid;gap:4px;padding:12px 0;border-bottom:1px solid var(--border)}
.strat-detail span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)}
.strat-detail strong{font-size:13px;line-height:1.5;color:var(--text-primary)}
.strat-library-toolbar{padding:18px 20px;display:flex;justify-content:space-between;gap:16px;align-items:flex-end}
.strat-filters{display:flex;align-items:flex-end;gap:8px;flex-wrap:wrap}
.strat-filters input{min-width:200px}
.strat-library-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:16px}
.strat-library-card{min-height:260px;display:flex;flex-direction:column;transition:transform .14s ease,box-shadow .14s ease,border-color .14s ease}
.strat-library-card:hover{transform:translateY(-2px);box-shadow:var(--shadow,0 10px 26px rgba(58,46,34,.08));border-color:var(--accent)}
.strat-card-top{display:flex;justify-content:space-between;align-items:center}
.strat-card-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:9px;background:var(--surface-active);border:1px solid var(--border);color:var(--accent)}
.strat-library-card h3{font-family:Georgia,serif;font-weight:500;font-size:19px;color:var(--text-primary);margin:5px 0 7px}
.strat-engine{font-family:monospace;font-size:11px;color:var(--accent);letter-spacing:.03em}
.strat-library-card p{font-size:12px;line-height:1.5;color:var(--text-secondary);margin:12px 0 18px}
.strat-card-actions{margin-top:auto;display:flex;gap:7px;align-items:center}
.icon-btn{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--border);background:var(--surface);color:var(--text-secondary);border-radius:8px;cursor:pointer}
.icon-btn:hover{color:var(--accent);border-color:var(--accent);background:var(--surface-hover)}
.small-btn{height:34px;margin-left:auto}
.strat-empty{padding:30px;text-align:center;display:grid;gap:6px}
.strat-empty strong{color:var(--text-primary)}
.strat-empty span{font-size:12px;color:var(--text-secondary)}
@media(max-width:1050px){.strat-library-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.strat-builder-grid{grid-template-columns:1fr}.strat-library-toolbar{align-items:flex-start;flex-direction:column}}
@media(max-width:700px){.strat-library-grid{grid-template-columns:1fr}.strat-filters{width:100%;align-items:stretch;flex-direction:column}.strat-filters input{min-width:0;width:100%}}
