/* Phase 7 — AI Analysis additions.
   Append these rules to frontend/app/globals.css. */
.ai-page-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--surface-active);color:var(--accent);border:1px solid var(--border)}
.ai-message{margin-bottom:16px}
.ai-summary{padding:20px;position:relative;overflow:hidden}
.ai-summary::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent)}
.ai-summary-title{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.ai-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:20px}
.ai-summary-grid>div{padding:12px;border:1px solid var(--border);border-radius:9px;background:var(--surface-hover)}
.ai-summary-grid span,.ai-fusion-grid span{display:block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:5px}
.ai-summary-grid strong{font-size:15px;font-variant-numeric:tabular-nums;color:var(--text-primary)}
.ai-debate-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.ai-panel{min-height:290px}
.ce-panel{border-top:3px solid var(--success)}
.pe-panel{border-top:3px solid var(--danger)}
.ai-panel-head,.ai-fusion-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px}
.ai-panel h3,.ai-fusion h3{font-family:Georgia,serif;font-size:20px;font-weight:500;margin-top:4px}
.ai-panel-icon{width:38px;height:38px;border-radius:9px;display:grid;place-items:center;border:1px solid var(--border);background:var(--surface-active);color:var(--accent)}
.ai-big-number{font-family:Georgia,serif;font-size:36px;margin:18px 0 2px;color:var(--text-primary)}
.ai-evidence{margin-top:18px;padding:13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-hover);font-size:13px;line-height:1.5;color:var(--text-secondary)}
.ai-empty{padding:22px;border:1px dashed var(--border);border-radius:9px;background:var(--surface-hover);display:grid;gap:7px}
.ai-empty strong{color:var(--text-primary)}
.ai-empty span{font-size:12px;line-height:1.45;color:var(--text-secondary)}
.ai-fusion{margin-top:16px}
.ai-fusion-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.ai-fusion-grid>div{padding:12px;border:1px solid var(--border);border-radius:9px;background:var(--surface-hover)}
.ai-fusion-grid strong{font-size:16px;color:var(--text-primary)}
.ai-reasoning{display:flex;gap:12px;align-items:flex-start;margin-top:16px;padding:15px;border-radius:10px;background:var(--surface-active);border:1px solid var(--border)}
.ai-reasoning-icon{width:34px;height:34px;flex:0 0 auto;display:grid;place-items:center;border-radius:8px;background:var(--surface);color:var(--accent);border:1px solid var(--border)}
.ai-reasoning strong{color:var(--text-primary)}
.ai-reasoning p{margin:5px 0 0;color:var(--text-secondary);font-size:13px;line-height:1.55}
@media(max-width:800px){.ai-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ai-debate-grid{grid-template-columns:1fr}.ai-fusion-grid{grid-template-columns:1fr}}
@media(max-width:500px){.ai-summary-title{flex-direction:column}.ai-summary-grid{grid-template-columns:1fr}}
