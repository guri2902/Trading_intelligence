/* Phase 10 — Paper Trading additions.
   Append these rules to frontend/app/globals.css. */
.paper-page-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--surface-active);color:var(--accent);border:1px solid var(--border)}
.paper-sim-badge{display:flex;align-items:center;gap:7px;padding:8px 11px;border-radius:8px;background:var(--warning-bg);color:var(--warning);border:1px solid var(--border);font-size:10px;font-weight:800;letter-spacing:.09em}
.paper-message{margin-bottom:16px}
.paper-status-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.paper-status-card{padding:14px 16px}
.paper-status-card span{display:block;color:var(--text-tertiary);font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
.paper-status-card strong{display:flex;align-items:center;gap:7px;color:var(--text-primary);font-size:15px;font-variant-numeric:tabular-nums}
.paper-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.paper-dot.good{background:var(--success)}
.paper-dot.bad{background:var(--danger)}
.paper-win{color:var(--success);font-weight:700;font-variant-numeric:tabular-nums}
.paper-loss{color:var(--danger);font-weight:700;font-variant-numeric:tabular-nums}
.paper-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;margin-top:16px}
.paper-panel{padding:20px;margin-top:16px}
.paper-grid .paper-panel{margin-top:0}
.paper-title{margin-top:5px;margin-bottom:16px}
.paper-empty{padding:30px;text-align:center;border:1px dashed var(--border);border-radius:9px;background:var(--surface-hover);display:grid;gap:6px}
.paper-empty strong{color:var(--text-primary)}
.paper-empty span{font-size:12px;line-height:1.5;color:var(--text-secondary)}
.paper-submit{width:100%;margin-top:3px}
.paper-warning{margin-top:12px;padding:10px 11px;border:1px solid var(--border);border-radius:8px;background:var(--danger-bg);color:var(--danger);font-size:11px;line-height:1.45}
.paper-action-note{margin-top:12px}
.paper-panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.paper-equity{min-height:170px}
.paper-equity-svg{display:block;width:100%;height:180px;color:var(--accent);background:var(--surface-hover);border:1px solid var(--border);border-radius:9px;padding:10px}
@media(max-width:1000px){.paper-status-row{grid-template-columns:repeat(2,minmax(0,1fr))}.paper-grid{grid-template-columns:1fr}}
@media(max-width:600px){.paper-status-row{grid-template-columns:1fr}.paper-panel-head{align-items:flex-start;flex-direction:column}}
