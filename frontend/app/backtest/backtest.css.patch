/* Phase 8 — Backtest additions.
   Append these rules to frontend/app/globals.css. */
.bt-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border);margin:16px 0 18px}
.bt-tab,.bt-result-tab{border:0;background:transparent;color:var(--text-secondary);padding:10px 14px;font:inherit;font-size:12px;font-weight:700;cursor:pointer;border-bottom:2px solid transparent}
.bt-tab.active,.bt-result-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.bt-tab:disabled{opacity:.4;cursor:not-allowed}
.bt-config-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}
.bt-config-card{padding:20px}
.bt-card-title{margin-top:5px;margin-bottom:18px}
.bt-selection{display:grid;gap:4px;padding:12px;border:1px solid var(--border);border-radius:9px;background:var(--surface-hover);margin:-4px 0 16px}
.bt-selection span{font-size:12px;line-height:1.45;color:var(--text-secondary)}
.bt-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.bt-status{margin-top:12px}
.bt-error{margin-top:12px}
.bt-integrity-list{display:grid;gap:13px;margin-top:16px}
.bt-integrity-list>div{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:flex-start}
.bt-integrity-list strong{display:block;color:var(--text-primary)}
.bt-integrity-list p{margin:4px 0 0;font-size:12px;line-height:1.45;color:var(--text-secondary)}
.bt-honesty{margin-top:16px}
.bt-summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.bt-metric{padding:12px;border:1px solid var(--border);border-radius:9px;background:var(--surface);min-width:0}
.bt-metric span{display:block;color:var(--text-tertiary);font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:5px}
.bt-metric strong{display:block;color:var(--text-primary);font-variant-numeric:tabular-nums;font-size:16px;overflow:hidden;text-overflow:ellipsis}
.bt-metric.good{border-left:3px solid var(--success)}
.bt-metric.bad{border-left:3px solid var(--danger)}
.bt-result-head{margin-top:16px;padding:17px 20px;display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.bt-result-badges{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.bt-result-tabs{display:flex;gap:3px;flex-wrap:wrap;border-bottom:1px solid var(--border);margin:16px 0}
.bt-section-title{font-family:Georgia,serif;font-size:20px;font-weight:500;margin:5px 0 16px;color:var(--text-primary)}
.bt-chart-wrap{position:relative;border:1px solid var(--border);border-radius:10px;background:var(--surface-hover);padding:16px 14px 12px;min-height:260px}
.bt-chart{width:100%;height:220px;display:block}
.bt-zero{stroke:var(--border);stroke-width:1}
.bt-equity-path{stroke:var(--accent);stroke-width:1.8;fill:none}
.bt-chart-label{position:absolute;font-size:10px;color:var(--text-tertiary);font-variant-numeric:tabular-nums}
.bt-chart-label.start{left:8px;bottom:6px}
.bt-chart-label.end{left:8px;top:6px}
.bt-mini-grid,.bt-detail-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}
.bt-trades-card{padding:0;overflow:hidden}
.bt-trade-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 20px;border-bottom:1px solid var(--border)}
.bt-trades{margin:0}
.bt-trades tbody tr:hover{background:var(--surface-hover)}
.bt-win{color:var(--success);font-weight:700;font-variant-numeric:tabular-nums}
.bt-loss{color:var(--danger);font-weight:700;font-variant-numeric:tabular-nums}
.bt-empty{padding:28px;text-align:center;color:var(--text-secondary);font-size:13px}
.bt-empty strong{display:block;color:var(--text-primary);margin-bottom:4px}
.bt-empty span{display:block}
.bt-regime-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.bt-regime-card{padding:15px;border:1px solid var(--border);border-radius:9px;background:var(--surface-hover)}
.bt-regime-name{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-secondary);margin-bottom:10px}
.bt-regime-card strong{display:block;font-size:18px;color:var(--text-primary)}
.bt-regime-card span{display:block;margin-top:5px;font-size:13px;color:var(--text-secondary);font-variant-numeric:tabular-nums}
.bt-regime-footer{display:flex;gap:8px;align-items:center;margin-top:14px;font-size:12px;color:var(--text-secondary)}
.bt-copy-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.bt-copy-grid p{margin:7px 0 0;color:var(--text-secondary);font-size:12px;line-height:1.5}
@media(max-width:1200px){.bt-summary-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.bt-config-grid{grid-template-columns:1fr}.bt-mini-grid,.bt-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:780px){.bt-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bt-result-head,.bt-trade-head{align-items:flex-start;flex-direction:column}.bt-result-badges{justify-content:flex-start}.bt-regime-grid,.bt-copy-grid{grid-template-columns:1fr}}
@media(max-width:500px){.bt-summary-grid,.bt-mini-grid,.bt-detail-grid{grid-template-columns:1fr}}
