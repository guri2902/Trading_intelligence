/* Phase 15 — Integration & QA polish.
   Append to frontend/app/globals.css after Phase 14. */

html,
body {
  max-width: 100%;
  overflow-x: hidden;
}

main {
  min-width: 0;
}

main > * {
  min-width: 0;
}

.card,
.topbar,
.note,
.error,
.table-wrap {
  min-width: 0;
}

.card *,
.topbar * {
  overflow-wrap: anywhere;
}

.numeric,
table td,
table th {
  font-variant-numeric: tabular-nums;
}

.loading-state {
  display: grid;
  place-items: center;
  min-height: 160px;
  padding: 24px;
  border: 1px dashed var(--border);
  border-radius: 9px;
  background: var(--surface-hover);
  color: var(--text-secondary);
  font-size: 12px;
}

.loading-state::before {
  content: "";
  width: 18px;
  height: 18px;
  margin-bottom: 9px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: ti-spin .7s linear infinite;
}

@keyframes ti-spin {
  to { transform: rotate(360deg); }
}

.status,
.pill,
.btn {
  flex-shrink: 0;
}

.table tbody tr:focus-within {
  background: var(--surface-hover);
}

.empty-state,
.history-empty,
.paper-empty,
.risk-empty,
.bt-empty,
.ai-empty {
  color: var(--text-secondary);
}

.table {
  max-width: 100%;
}

@media (max-width: 620px) {
  .topbar {
    align-items: flex-start;
  }

  .topbar > .status,
  .topbar > .pill,
  .topbar > .btn {
    width: max-content;
    max-width: 100%;
  }

  .btn {
    min-height: 40px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .loading-state::before {
    animation: none;
  }
}
